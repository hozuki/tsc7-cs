<Project Sdk="Microsoft.NET.Sdk">

  <!-- 移植目标：TSGO（github.com/microsoft/TypeScript/tsc/internal/*）的 1:1 移植。
       一个 Go package = 一个同名文件夹 + 同名 C# 命名空间（internal/core → TypeScript.Core），
       Go 文件名转成 PascalCase 的 .cs 文件名（core.go → Core.cs）。这样任何一个文件都能和
       Go 源文件并排对照阅读。详见 docs/architecture.md。 -->
  <PropertyGroup>
    <RootNamespace>TypeScript</RootNamespace>
    <AssemblyName>TypeScript.Compiler</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>TypeScript.Compiler</PackageId>
    <Description>C# port of the TypeScript compiler (TSGO).</Description>
  </PropertyGroup>

  <!-- 本地化数据（internal/diagnostics/loc/*.json.gz 的已提交产物，由 tools/TypeScript.CodeGen 的
       DiagnosticsGenerator 逐字节复制到本目录）作为 EmbeddedResource 嵌入。LogicalName 显式固定成
       "TypeScript.Diagnostics.loc.<语言>.json.gz"，与 Diagnostics/Localizations.Generated.cs 里的常量表逐字一致
       （运行时用 Assembly.GetManifestResourceStream 取，不用反射枚举资源，AOT 安全）；显式写 LogicalName 是因为
       MSBuild 的默认资源名会把路径里的 '-' 换成 '_'，那样资源名就和生成物对不上了。 -->
  <ItemGroup>
    <EmbeddedResource Include="Diagnostics\loc\*.json.gz">
      <LogicalName>TypeScript.Diagnostics.loc.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- bundled libs（internal/bundled/libs 的 108 个 .d.ts，共 3,784,983 字节，由 tools/TypeScript.CodeGen 的
       BundledGenerator 从 TSGO 逐字节复制）作为 EmbeddedResource 嵌入。LogicalName 固定成
       "TypeScript.Bundled.libs." + 文件名，与 Bundled/Embed.Generated.cs 里生成的 EmbeddedContents 表逐字一致
       （运行时用 Assembly.GetManifestResourceStream 按名取，不用反射枚举资源，AOT 安全）。显式写 LogicalName 是
       因为 MSBuild 的默认资源名会带上项目内的相对路径，那样资源名就和生成物对不上了；
       %(Filename) 是不含最后一段扩展名的文件名（lib.dom.d.ts → lib.dom.d），拼 %(Extension)（.ts）即原名。 -->
  <ItemGroup>
    <EmbeddedResource Include="Bundled\libs\*.d.ts">
      <LogicalName>TypeScript.Bundled.libs.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
