root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{csproj,props,targets,slnx,json,jsonc}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.cs]
dotnet_sort_system_directives_first = true
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0005.severity = suggestion

# 命名规则（用户要求；理由与完整说明见 docs/architecture.md §2）：
# 公开 API 与 TSGO 一致（Go 导出成员名字原样保留）；非公开成员一律按 C# 习惯命名。
# 1) **private/protected** 字段 → _camelCase。刻意**不含 internal**：internal 大量用来镜像 Go 的
#    package-private/导出成员（例如内部类型上保留 Go 导出名的 `ResolvedModule.Path`），强制加 `_`
#    会破坏与 Go 的逐名对应关系。
dotnet_naming_rule.non_public_fields_should_be_underscore_camel.severity = warning
dotnet_diagnostic.IDE1006.severity = warning
dotnet_naming_rule.non_public_fields_should_be_underscore_camel.symbols = non_public_fields
dotnet_naming_rule.non_public_fields_should_be_underscore_camel.style = underscore_camel
dotnet_naming_symbols.non_public_fields.applicable_kinds = field
dotnet_naming_symbols.non_public_fields.applicable_accessibilities = private, private_protected, protected, protected_internal
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# 2) 方法/属性/事件 → PascalCase（任何可见性）
dotnet_naming_rule.members_should_be_pascal_case.severity = warning
dotnet_naming_rule.members_should_be_pascal_case.symbols = members
dotnet_naming_rule.members_should_be_pascal_case.style = pascal_case

dotnet_naming_symbols.members.applicable_kinds = method, property, event
dotnet_naming_style.pascal_case.capitalization = pascal_case

# 3) 局部变量与参数 → camelCase
dotnet_naming_rule.locals_should_be_camel_case.severity = warning
dotnet_naming_rule.locals_should_be_camel_case.symbols = locals_and_parameters
dotnet_naming_rule.locals_should_be_camel_case.style = camel_case

dotnet_naming_symbols.locals_and_parameters.applicable_kinds = local, parameter
dotnet_naming_style.camel_case.capitalization = camel_case
