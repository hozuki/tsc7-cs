<Project>

  <!-- 所有项目共享的编译契约。项目级 csproj 只保留真正项目特有的设置。 -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <!-- 对应 TS 的 strictNullChecks：undefined/null 的处理必须显式 -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <!-- 移植自 TS 的文件用 // ported from: 标注，不要求 XML 文档注释 -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- AOT 兼容（用户要求）：打开 trim/AOT/单文件分析器（IL2xxx/IL3xxx 会因 TreatWarningsAsErrors 直接报错）。
         实际影响（docs/architecture.md §3.6）：**禁止运行时反射驱动的序列化/映射**——不用
         System.Text.Json 的 JsonSerializer（IL2026/IL3050），不自己 GetProperties/Activator.CreateInstance(Type)；
         类型映射走静态分派 + 显式 IJsonMarshaler/IJsonUnmarshaler（对应 Go 的 MarshalerTo/UnmarshalerFrom）。
         这不只是"消除警告"：反射映射在真 AOT/裁剪下会静默丢成员，正是 TSGO 里 Go 代码到处自己实现
         MarshalerTo 的原因。 -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- .NET 11 的 runtime async：状态机交给运行时，同步完成的 await 不再走编译器生成的状态机/延续结构。
         实测数据见 docs/architecture.md §3.10（探针 artifacts/asyncbench，用 hez2010 的 async 基准逐形态量过：
         不挂起的 async 方法 RA on 8.5 ns/0 B vs off 33 ns/104 B；3 层 async 链 128 ns/240 B vs 513 ns/413 B）。
         开关必须写在这里/csproj —— 用 `-p:Features=…` 改不了（props 是追加语义，且 MSBuild 增量编译只看输入输出）。
         当前 src 与 tools 没有任何 async 代码，这条是给 M8 的 CLI/host/watch（那里才有真实等待）预付的；
         若某个构造被 runtime async 拒绝（Roslyn 的 ERR_UnsupportedFeatureInRuntimeAsync），用
         `[RuntimeAsyncMethodGeneration(false)]` 单独退出即可。 -->
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

</Project>
